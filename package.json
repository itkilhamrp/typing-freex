{
  "name": "typing_freex",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=10.0.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:mcp": "tauri dev --features mcp-dev --config src-tauri/tauri.conf.mcp.json",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "tool:replay": "tsx scripts/tool-replay.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "phosphor-svelte": "^3.1.1",
    "svelte": "^5.57.3",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-svelte": "^3.23.1",
    "fast-check": "^3.23.2",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^5.14.0",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.9.0",
    "tailwindcss": "^4.3.5",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
