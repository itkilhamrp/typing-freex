{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Typing FreeX Keyboard Layout Pack Schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "keys",
    "modifiers"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "base",
          "finger"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "shift": {
            "type": "string"
          },
          "finger": {
            "enum": [
              "l_pinky",
              "l_ring",
              "l_middle",
              "l_index",
              "l_thumb",
              "r_thumb",
              "r_index",
              "r_middle",
              "r_ring",
              "r_pinky"
            ]
          }
        }
      }
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "l_pinky",
          "l_ring",
          "l_middle",
          "l_index",
          "l_thumb",
          "r_thumb",
          "r_index",
          "r_middle",
          "r_ring",
          "r_pinky"
        ]
      }
    }
  }
}